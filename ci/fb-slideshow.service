# systemd user service for the slideshow on hydra.
# Deployed to ~/fb-slideshow/ci/ and copied unchanged to
# ~/.config/systemd/user/ by "ci/show.sh install" (part of "make deploy").
# By hand on hydra:
#   cp ~/fb-slideshow/ci/fb-slideshow.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user restart fb-slideshow.service
# Starts at boot because linger is enabled for the user (loginctl
# enable-linger). %h is the user's home directory.
#
# Options for fb-slideshow.py: DEFAULT_ARGS below are always passed; the
# options saved with "make config SHOW_ARGS='--shuffle --hold 20'" (SHOW_ARGS
# in ~/.config/fb-slideshow/env) come after them, so they add to the defaults
# and win where they set the same option.
#
# sequence.py plays the steps in /mnt/stick/config.yaml (slideshow and
# scenes); without that file it is the plain slideshow (fb-slideshow.py).

[Unit]
Description=Framebuffer slideshow on the SPI display
Documentation=https://github.com/fritzthekid/fb-slideshow
# keep retrying while /dev/fb1 or the stick are not ready after boot
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/fb-slideshow
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 SHOW_ARGS=
Environment="DEFAULT_ARGS=--transitions stack --duration 3 --easing ease-out"
EnvironmentFile=-%h/.config/fb-slideshow/env
ExecStart=/usr/bin/python3 %h/fb-slideshow/sequence.py $DEFAULT_ARGS $SHOW_ARGS
# Restarted after every error (exit code != 0, crash, killed by a signal
# other than SIGTERM): exit code 2 = framebuffer not readable yet, 3 = display
# options changed. Not restarted after "make stop" / systemctl stop (SIGTERM
# exits cleanly with 0) or when a config with "loop: false" has finished.
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=default.target
